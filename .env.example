# Database (Supabase)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=math_tutor
POSTGRES_PORT=5432
BACKEND_PORT=8000
ENVIRONMENT=development
ANONYMOUS_TOKEN_SECRET=replace_with_long_random_secret

# AI Services
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
# Tavily for Video generation
TAVILY_API_KEY=your_tavily_key

# Backboard.io (Long-term Memory)
BACKBOARD_API_KEY=your_backboard_api_key
BACKBOARD_ASSISTANT_NAME="STEM Math Tutor"

# Supabase Auth & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Langchain
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT="multi-agent-tutor"

# Database Connection String (Direct connection for migrations/scripts)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
